@model SiteContent
@{
    HeroSettings hero = Model.Hero;
    List<StatItem> stats = Model.Stats.Where(s => !string.IsNullOrWhiteSpace(s.Value)).ToList();
    string heroAlt = Model.Header.SiteName;
}

<section class="hero" id="home" data-section="hero">
    <div class="wrap">
        <div class="hero-stage">
            @if (hero.ShowDecorations)
            {
                <svg class="deco deco--s1" aria-hidden="true"><use href="#i-sparkle" /></svg>
                <svg class="deco deco--s2" aria-hidden="true"><use href="#i-sparkle" /></svg>
                <svg class="deco deco--h1" aria-hidden="true"><use href="#i-heart" /></svg>
                <svg class="deco deco--s3" aria-hidden="true"><use href="#i-sparkle-outline" /></svg>
            }

            <h1 class="hero-title">
                <span class="hero-title__first">@hero.TitleLine1</span>
                <span class="hero-title__last">@hero.TitleLine2</span>
            </h1>

            <div class="hero-arch">
                <svg class="hero-arch__bow" aria-hidden="true"><use href="#i-bow" /></svg>
                <div class="hero-arch__frame">
                    @if (!string.IsNullOrEmpty(hero.PhotoUrl))
                    {
                        <img src="@Url.Content(hero.PhotoUrl)" alt="@heroAlt" fetchpriority="high" />
                    }
                    else
                    {
                        <svg class="hero-arch__silhouette" viewBox="0 0 200 260" preserveAspectRatio="xMidYMax meet" aria-hidden="true">
                            <defs>
                                <linearGradient id="hair" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0" style="stop-color: var(--orange-light)" />
                                    <stop offset="1" style="stop-color: var(--orange-soft)" />
                                </linearGradient>
                                <linearGradient id="face" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0" style="stop-color: var(--peach-2)" />
                                    <stop offset="1" style="stop-color: var(--peach); stop-opacity: 0" />
                                </linearGradient>
                            </defs>
                            <path fill="url(#hair)" d="M100 16c-48 0-66 44-68 98-2 58-14 102-38 146h212c-24-44-36-88-38-146-2-54-20-98-68-98z" />
                            <path fill="url(#face)" d="M100 30c-26 0-40 18-40 44 0 40 22 76 40 98 18-22 40-58 40-98 0-26-14-44-40-44z" />
                        </svg>
                        <span class="pill pill--light hero-arch__pill">Your photo here</span>
                    }
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(hero.Tagline))
            {
                <p class="hero-script" aria-hidden="true">
                    @hero.Tagline <svg class="icon"><use href="#i-heart-outline" /></svg>
                </p>
            }
        </div>

        <div class="hero-bottom">
            <div class="hero-intro">
                @if (!string.IsNullOrWhiteSpace(hero.IntroTitle))
                {
                    <h2>@hero.IntroTitle <svg class="icon" aria-hidden="true"><use href="#i-heart-outline" /></svg></h2>
                }
                <p>@hero.IntroText</p>
            </div>

            @if (stats.Count > 0)
            {
                <ul class="hero-stats">
                    @foreach (StatItem stat in stats)
                    {
                        <li class="stat-card">
                            <strong>@stat.Value</strong>
                            <span>@stat.Label</span>
                        </li>
                    }
                </ul>
            }

            <div class="hero-meta">
                @if (!string.IsNullOrWhiteSpace(hero.Specialties))
                {
                    <p class="hero-meta__title">@hero.Specialties</p>
                }
                @if (!string.IsNullOrWhiteSpace(hero.Location))
                {
                    <p>
                        @hero.Location
                        @if (!string.IsNullOrWhiteSpace(hero.LocationBadge))
                        {
                            <abbr>@hero.LocationBadge</abbr>
                        }
                    </p>
                }
                <p>@hero.Availability</p>
            </div>
        </div>

        @if (Model.Socials.Count > 0)
        {
            <ul class="socials">
                @foreach (SocialAccount social in Model.Socials)
                {
                    <li>
                        <a class="social-card" href="@Url.Content(string.IsNullOrWhiteSpace(social.Url) ? "#" : social.Url)" target="_blank" rel="noopener">
                            <span class="social-card__icon"><svg aria-hidden="true"><use href="#i-@social.Icon" /></svg></span>
                            <span class="social-card__name">
                                <strong>@social.Platform</strong>
                                <span>@social.Handle</span>
                            </span>
                            @if (!string.IsNullOrWhiteSpace(social.Count))
                            {
                                <span class="social-card__count">
                                    <strong>@social.Count</strong>
                                    <span>@social.CountLabel</span>
                                </span>
                            }
                        </a>
                    </li>
                }
            </ul>
        }
    </div>
</section>
