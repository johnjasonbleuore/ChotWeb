@model SetupViewModel
@{
    ViewData["Title"] = "Create admin account";
    ViewData["BodyClass"] = "admin--auth";
}

<div class="auth-card">
    <div class="auth-card__logo">C</div>
    <h1>Create your admin account</h1>
    <p class="auth-card__lead">
        This only happens once. Enter the <strong>setup code</strong> shown in the
        <strong>Debug Console</strong> (VS Code) or the server log when the site started.
        It's also saved in <code>App_Data/setup-code.txt</code>.
    </p>

    <form method="post" asp-action="Setup" novalidate>
        <div asp-validation-summary="ModelOnly" class="form-error"></div>

        <label class="field">
            <span>Setup code</span>
            <input asp-for="SetupCode" autocomplete="off" placeholder="XXXX-XXXX" autofocus />
            <span asp-validation-for="SetupCode" class="field__error"></span>
        </label>

        <label class="field">
            <span>Username</span>
            <input asp-for="Username" autocomplete="username" />
            <span asp-validation-for="Username" class="field__error"></span>
        </label>

        <label class="field">
            <span>Password <small>(at least 8 characters)</small></span>
            <input asp-for="Password" autocomplete="new-password" />
            <span asp-validation-for="Password" class="field__error"></span>
        </label>

        <label class="field">
            <span>Confirm password</span>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field__error"></span>
        </label>

        <button class="abtn abtn--primary abtn--block" type="submit">Create account</button>
    </form>
</div>
