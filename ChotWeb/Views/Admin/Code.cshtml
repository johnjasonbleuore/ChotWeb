@model LoginCodeViewModel
@{
    ViewData["Title"] = "Enter your code";
    ViewData["BodyClass"] = "admin--auth";
}

<div class="auth-card">
    <div class="auth-card__logo">C</div>
    <h1>Check your email</h1>
    <p class="auth-card__lead">
        If <strong>@Model.Email</strong> is on the admin list, we've sent it a 6-digit code.
        It may take a minute, and it can land in spam.
    </p>

    <form method="post" asp-action="Code" novalidate>
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="form-error"></div>

        <label class="field">
            <span>6-digit code</span>
            <input asp-for="Code" autocomplete="one-time-code" inputmode="numeric" maxlength="7" placeholder="123456" class="code-input" autofocus />
            <span asp-validation-for="Code" class="field__error"></span>
        </label>

        <label class="check">
            <input asp-for="RememberMe" />
            <span>@Html.DisplayNameFor(m => m.RememberMe)</span>
        </label>

        <button class="abtn abtn--primary abtn--block" type="submit">Sign in</button>
    </form>

    <p class="auth-card__links">
        <a asp-action="Login" asp-route-email="@Model.Email" asp-route-returnUrl="@Model.ReturnUrl">Send a new code</a>
        <span aria-hidden="true">·</span>
        <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Use a different email</a>
    </p>
</div>
