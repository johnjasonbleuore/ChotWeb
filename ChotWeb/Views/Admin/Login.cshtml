@model LoginEmailViewModel
@{
    ViewData["Title"] = "Sign in";
    ViewData["BodyClass"] = "admin--auth";
}

<div class="auth-card">
    <div class="auth-card__logo">C</div>
    <h1>Welcome back</h1>
    <p class="auth-card__lead">Enter your email and we'll send you a 6-digit sign-in code.</p>

    <form method="post" asp-action="Login" novalidate>
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="form-error"></div>

        <label class="field">
            <span>Email</span>
            <input asp-for="Email" type="email" autocomplete="email" inputmode="email" autofocus />
            <span asp-validation-for="Email" class="field__error"></span>
        </label>

        <button class="abtn abtn--primary abtn--block" type="submit">Send code</button>
    </form>
</div>
