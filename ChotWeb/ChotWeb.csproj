<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Keeps admin usernames/passwords out of the code on your PC: dotnet user-secrets set "Admin:Users" "chot:password1; manager:password2" -->
    <UserSecretsId>chotweb-0b6f6c8e-5d0e-4a7e-9a52-3c1f0f7d2b41</UserSecretsId>
  </PropertyGroup>

  <!-- App_Data holds runtime data (site content, uploads, sign-in keys).
       Keep it out of the build and publish output so publishing never overwrites the live site's data. -->
  <ItemGroup>
    <Content Remove="App_Data\**" />
    <None Remove="App_Data\**" />
    <Compile Remove="App_Data\**" />
  </ItemGroup>

</Project>
