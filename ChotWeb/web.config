<?xml version="1.0" encoding="utf-8"?>
<!-- Used when the site is hosted on IIS. Publishing adds the ASP.NET Core handler to this file automatically. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering>
          <!-- Let the admin upload videos up to 300 MB (IIS blocks anything over 30 MB by default). -->
          <requestLimits maxAllowedContentLength="315621376" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
